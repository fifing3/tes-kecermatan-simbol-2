{
  "entities": {
    "AccessCode": {
      "title": "AccessCode",
      "description": "An access code for the simulation exam",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "The unique access code"
        },
        "is_active": {
          "type": "number",
          "description": "1 if active, 0 if inactive"
        },
        "created_at": {
          "type": "string"
        },
        "expires_at": {
          "type": ["string", "null"]
        },
        "session_id": {
          "type": ["string", "null"]
        }
      },
      "required": ["code", "is_active", "created_at"]
    }
  },
  "firestore": {
    "access_codes/{codeId}": {
      "schema": "AccessCode",
      "description": "Stores access codes generated by the admin"
    }
  }
}
